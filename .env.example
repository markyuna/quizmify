# Database
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Optional: minutes of inactivity before an authenticated session is signed
# out automatically. Defaults to 30 if unset.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Image model for Puzzle Mode. Defaults to gpt-image-1. Note that many keys
# have no access to dall-e-3 at all -- check /v1/models before setting this.
OPENAI_IMAGE_MODEL=gpt-image-1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email). Without a verified sending domain, Resend
# only allows sending to the account's own email -- fine for dev/testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: if set, /api/cron/* routes require this as a Bearer token.
# Vercel sets it automatically for its own cron invocations.
CRON_SECRET=
