generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "account_userId_idx")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  subscriptionStatus     String                  @default("free")
  stripeCustomerId       String?
  stripePaymentId        String?                 @unique
  xp                     Int                     @default(0)
  level                  Int                     @default(1)
  currentStreak          Int                     @default(0)
  longestStreak          Int                     @default(0)
  lastQuizDate           DateTime?
  streakProtectionsUsed  Int                     @default(0)
  streakProtectionMonth  String?
  // IANA timezone (e.g. "America/Argentina/Buenos_Aires"), captured
  // client-side on login -- see TimezoneSync.tsx. Null until the user's
  // browser has reported it at least once; notification scheduling treats
  // that as "unknown, send anyway" rather than skipping them.
  timezone               String?
  // Temporary Pro access granted by referrals or the free trial, additive
  // to (never a substitute for) a real paid subscriptionStatus="pro". See
  // isEffectivelyPro() in src/lib/paywall.ts -- the single source of truth
  // for every Pro gate in the app.
  premiumUntil           DateTime?
  // Set once, the first time the free trial is activated -- distinct from
  // premiumUntil so "already used the trial" stays true even after it
  // expires and premiumUntil is in the past.
  freeTrialUsedAt        DateTime?
  // References an id in the hardcoded catalog in src/lib/avatarSkins.ts,
  // not a DB table -- same "visuals live in code, not the database" idiom
  // already used for avatar tiers and trophy shapes. Selection persists
  // even if Pro lapses; only *applying* it visually is gated on isPro at
  // read time (see dashboard/page.tsx), so it comes right back if they
  // resubscribe.
  selectedSkinId         String?
  accounts               Account[]
  sessions               Session[]
  games                  Game[]
  attempts               Attempt[]
  questionProgress       UserQuestionProgress[]
  trophies               Trophy[]
  certificates           Certificate[]
  topicRecommendations   TopicRecommendation[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]
  friendshipsSent        Friendship[]            @relation("FriendshipRequester")
  friendshipsReceived    Friendship[]            @relation("FriendshipAddressee")
  referralsMade          Referral[]              @relation("ReferralsMade")
  referralReceived       Referral?               @relation("ReferralReceived")
  guestAttemptsClaimed   GuestAttempt[]
  personalityTestAttemptsClaimed PersonalityTestAttempt[]
  curatedQuizCompletions CuratedQuizCompletion[]

  @@index([xp])
}

model Game {
  id                 String     @id @default(cuid())
  gameType           GameType
  timeStarted        DateTime   @default(now())
  timeEnded          DateTime?
  topic              String
  difficulty         String?
  language           String     @default("en")
  // Nullable to support guest-played quizzes (see src/app/api/game/route.ts):
  // exactly one of userId/guestId is set. userId is set for real users, and
  // gets backfilled onto a guest's game by /api/guest/claim-quiz the moment
  // they register -- guestId is left in place after that purely as a claim
  // audit trail, never re-read for access control once claimedAt is set.
  userId             String?
  // Opaque id from the quizmify_guest cookie (same non-PII partition-key
  // pattern as GuestAttempt.guestId in guestPlay.ts). Set only while a game
  // has no owning account yet.
  guestId            String?
  // Set once, the first time a guest's game is migrated onto a real account
  // by /api/guest/claim-quiz -- null means "still guest-owned, or always was
  // a real user's game." Never re-applied once set (mirrors
  // GuestAttempt.claimedByUserId/claimedAt).
  claimedAt          DateTime?
  score              Int        @default(0)
  isTimed            Boolean    @default(false)
  timePerQuestionSec Int?
  // Set only for quizzes long enough to split into two adaptive-difficulty
  // batches (see src/lib/adaptiveDifficulty.ts). Null means "generated
  // upfront as one batch, no adaptation" -- the pre-existing behavior for
  // short quizzes and every non-/api/game creation path (daily challenge,
  // Practice Mistakes), and always the case for guest-played quizzes.
  plannedQuestionCount Int?
  // Set only when this game was created with Puzzle Mode (Pro-only): a
  // DALL-E image generated from the topic, persisted to Supabase Storage
  // (OpenAI's own URLs expire after about an hour). Its presence is what
  // drives rendering the jigsaw reveal in MCQ.tsx -- there's no separate
  // boolean, since a game either has a puzzle image or it doesn't.
  puzzleImageUrl     String?
  // Set at creation time (POST /api/game) when the player already knew --
  // explicitly picked, or inherited from a category catalog page -- which
  // category this topic belongs to. Validated against CATEGORIES in
  // src/lib/categories.ts at write time, not a Prisma enum. This is the
  // server-authoritative source /api/quiz/submit reads from to publish a
  // CategoryTopic row -- deliberately not re-trusted from the client at
  // submit time, so a hidden category selector (see QuizCreation.tsx) can't
  // be worked around by tampering with the submit request.
  categorySlug       String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions          Question[]
  attempts           Attempt[]
  trophies           Trophy[]

  @@index([userId])
  @@index([userId, timeStarted])
  @@index([guestId])
}

model McqQuestion {
  id             String   @id @default(cuid())
  topic          String
  difficulty     String
  language       String   @default("en")
  question       String
  options        String[]
  correct_answer String
  explanation    String?
  country        String?
  is_active      Boolean  @default(true)
  usage_count    Int      @default(0)
  created_at     DateTime @default(now())

  @@map("mcq_questions")
}

model Question {
  id               String                 @id @default(cuid())
  question         String
  answer           String
  options          String[]
  questionType     String
  explanation      String?
  userAnswer       String?
  isCorrect        Boolean?
  orderIndex       Int?
  country          String?
  imageUrl         String?
  gameId           String
  sourceQuestionId String?
  game             Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progressEntries  UserQuestionProgress[]

  @@index([gameId])
  @@index([sourceQuestionId])
}

model Attempt {
  id             String          @id @default(cuid())
  userId         String
  gameId         String
  score          Int
  totalQuestions Int
  correctAnswers Int
  timeSpent      Int
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers        AttemptAnswer[]

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([createdAt])
}

model AttemptAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  responseTimeMs Int?
  attempt        Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// One row per (user, curated topic) the user has ever earned XP for --
// the anti-grinding guard for curated quizzes (see quiEstLePeintre.ts):
// unlike AI-generated topics, a curated quiz's question pool is fixed, so
// nothing stops a user from creating a fresh Game for the same topic over
// and over and collecting XP every time. /api/quiz/submit and
// /api/guest/claim-quiz both attempt to create this row before crediting
// XP for a curated-topic game; a unique constraint violation means this
// user already has XP for that topic, so that submit/claim grants no
// additional XP (the game itself, streak, certificates and trophies are
// never gated -- replaying is still allowed and still full-featured for
// practice, only the XP grant is one-time). Mirrors NotificationLog's
// unique-constraint-is-the-real-guard pattern.
model CuratedQuizCompletion {
  id              String   @id @default(cuid())
  userId          String
  categorySlug    String
  topicNormalized String
  gameId          String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categorySlug, topicNormalized])
  @@index([userId])
}

enum GameType {
  mcq
}

model Certificate {
  id       String          @id @default(cuid())
  userId   String
  kind     CertificateKind
  // Empty string ("") for kinds not scoped to a topic (quizzes_50, streak_7)
  // rather than null -- Postgres treats NULL as distinct-from-itself in
  // unique indexes, which would silently defeat @@unique below.
  topic    String          @default("")
  earnedAt DateTime        @default(now())
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, topic])
  @@index([userId])
}

enum CertificateKind {
  quizzes_50
  category_mastery
  streak_7
}

// Cached AI-generated "practice this topic" suggestion, regenerated only
// when the user's stats move meaningfully (see src/lib/recommendations.ts)
// so we don't pay an OpenAI call on every dashboard load.
model TopicRecommendation {
  id                    String   @id @default(cuid())
  userId                String
  // Part of the cache key (not just a display field) so switching the
  // site's language doesn't keep serving a message generated in the old
  // one -- each language gets its own cached row per user.
  language              String   @default("en")
  topic                 String
  message               String
  accuracy              Float
  quizCountAtGeneration Int
  generatedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
}

model Trophy {
  id          String     @id @default(cuid())
  userId      String
  gameId      String?
  kind        TrophyKind
  streakCount Int?
  createdAt   DateTime   @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([gameId])
}

enum TrophyKind {
  perfect
  streak
}

model UserQuestionProgress {
  id                    String   @id @default(cuid())
  userId                String
  questionId            String
  wrongCount            Int      @default(0)
  correctCount          Int      @default(0)
  needsReview           Boolean  @default(false)
  lastAnsweredCorrectly Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([userId, needsReview])
}

// One shared quiz per UTC calendar day *per language*, identical for every
// user in that language. `date` is a "YYYY-MM-DD" string (not a DateTime)
// purely so it can be part of a simple composite unique key -- see
// src/lib/dailyChallenge.ts for generation/lookup.
model DailyChallenge {
  id         String   @id @default(cuid())
  date       String
  topic      String
  difficulty String
  language   String
  createdAt  DateTime @default(now())

  questions DailyChallengeQuestion[]
  attempts  DailyChallengeAttempt[]

  @@unique([date, language])
}

model DailyChallengeQuestion {
  id               String   @id @default(cuid())
  dailyChallengeId String
  question         String
  answer           String
  options          String[]
  explanation      String?
  orderIndex       Int

  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@index([dailyChallengeId])
}

model DailyChallengeAttempt {
  id                  String   @id @default(cuid())
  dailyChallengeId    String
  userId              String
  score               Int
  correctAnswers      Int
  totalQuestions      Int
  timeSpent           Int
  // XP breakdown, stored (not just returned) so the "already played" view
  // can show the same numbers on a later page load, not just right after
  // submit. earnedXp is the actual amount applied to User.xp (may be less
  // than baseXp + aboveAverageBonusXp if it was clamped by the free-tier cap).
  baseXp              Int      @default(0)
  aboveAverageBonusXp Int      @default(0)
  earnedXp            Int      @default(0)
  createdAt           DateTime @default(now())

  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces "one attempt per user per day" at the database level, not just
  // in application code.
  @@unique([dailyChallengeId, userId])
  @@index([dailyChallengeId])
  @@index([userId])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  streakReminderEmail  Boolean  @default(true)
  dailyChallengeEmail  Boolean  @default(true)
  weeklySummaryEmail   Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  streak_reminder
  daily_challenge_reminder
  weekly_summary
  premium_ending_soon
}

model NotificationLog {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  // User's local calendar date ("YYYY-MM-DD") at send time for
  // streak_reminder/daily_challenge_reminder, or the ISO week ("YYYY-Www")
  // for weekly_summary. The real anti-duplicate guard is the unique
  // constraint below, not the application check that precedes it.
  dateKey String
  sentAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dateKey])
  @@index([userId])
}

enum FriendshipStatus {
  pending
  accepted
}

// A pending row means requester -> addressee only; it becomes a mutual
// friendship the moment addressee accepts. There's deliberately no way to
// read someone's progress via this relation while status is "pending" --
// see getFriendIds() in src/lib/friends.ts, which only ever queries
// status: accepted.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

// One row per successfully-referred signup. @@unique on referredId means a
// given account can only ever be counted as "referred" once, by whoever's
// link they used first.
model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  rewardDays Int
  createdAt  DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

enum GuestGameKey {
  word_of_day
  photo_of_day
  math_target
}

// One shared daily challenge per game per calendar day (UTC "YYYY-MM-DD")
// per language -- same idiom as DailyChallenge, but payload is opaque JSON
// because each guest game has a completely different challenge shape (a
// target word vs. a photo+location vs. a target number+operands). Never
// includes the answer key -- that's derived server-side at submit time by
// the grader registered for this gameKey in src/lib/guestPlay.ts.
model DailyGameChallenge {
  id        String       @id @default(cuid())
  gameKey   GuestGameKey
  date      String
  language  String       @default("en")
  payload   Json
  createdAt DateTime     @default(now())

  attempts GuestAttempt[]

  @@unique([gameKey, date, language])
  @@index([gameKey, date])
}

// A guest's single daily attempt at one game, before any account exists.
// guestId is an opaque id minted client-side and stashed in a cookie (same
// pattern as the quizmify_ref referral cookie) -- never PII. Scored and
// persisted server-side so the result can't be forged by the client, and so
// it survives the guest closing the conversion modal and coming back later
// in the same browser. claimedByUserId/claimedAt are set once, the first
// time /api/guest/claim successfully migrates this attempt onto a real
// account; already-claimed rows are never re-applied.
model GuestAttempt {
  id              String       @id @default(cuid())
  challengeId     String
  gameKey         GuestGameKey
  date            String
  guestId         String
  resultPayload   Json
  isCorrect       Boolean
  xpEarned        Int
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime     @default(now())

  challenge DailyGameChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  claimedBy User?              @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  // One attempt per guest per game per day -- mirrors the
  // [dailyChallengeId, userId] guard on DailyChallengeAttempt.
  @@unique([challengeId, guestId])
  @@index([guestId])
  @@index([claimedByUserId])
}

// Personality tests are evergreen content (not date-rotated like the 3
// GuestGameKey games) with no correct/incorrect answer -- just an
// accumulated score per candidate result, so they get their own key enum
// and attempt model rather than reusing GuestGameKey/GuestAttempt/
// DailyGameChallenge. Question/option/weight/result-profile content lives
// in code (src/lib/personalityTests/*.config.ts) + messages/*.json, not in
// the database -- it's fixed editorial content, not AI-generated or
// admin-edited, so there's nothing here that needs a content table.
enum PersonalityTestKey {
  quel_animal_es_tu
}

// A guest's (or user's) run through one personality test. Unlike
// GuestAttempt there is no daily-challenge relation and no unique
// constraint on [testKey, guestId] -- retaking an evergreen test is
// expected, not an edge case. guestId/claimedByUserId/claimedAt mirror
// GuestAttempt exactly: scored and persisted server-side so the result
// can't be forged by the client and can't be read back before the guest
// registers (see /api/personality-tests/[testKey]/submit).
model PersonalityTestAttempt {
  id              String             @id @default(cuid())
  testKey         PersonalityTestKey
  guestId         String
  // [{ questionId: "q1", optionId: "q1_b" }, ...] -- the guest's raw picks,
  // kept so a future "see your answers" or re-scoring pass has something
  // to work from.
  answers         Json
  // Final per-animal point totals, e.g. { lion: 4, dauphin: 2, ... } --
  // computed server-side by computeResult(), never trusted from the client.
  scores          Json
  // The winning animal key, e.g. "lion" -- denormalized out of `scores` so
  // the result page and OG metadata don't need to re-run the tie-break
  // logic every render.
  resultKey       String
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime           @default(now())

  claimedBy User? @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([guestId])
  @@index([claimedByUserId])
  @@index([testKey, resultKey])
}

// A free-topic quiz (Game.topic) published into one of the 18 categories in
// src/lib/categories.ts once its creator (an authenticated user, never a
// guest -- see POST /api/quiz/submit) finishes it, so other users can play
// the exact same cached questions without spending new AI tokens. No FK
// relation to Game (relationMode = "prisma", and this row must outlive the
// Game it came from) -- createdByGameId is plain traceability, not a join
// target. Deliberately no play-count/trending counter here: popularity is
// computed at read time from Game.topic + Game.timeEnded (see
// src/lib/categoryTopics.ts), so there's nothing here to desync.
model CategoryTopic {
  id              String    @id @default(cuid())
  // Validated against CATEGORIES in src/lib/categories.ts at write time, not
  // a Prisma enum -- categories are edited in code, not via migration.
  categorySlug    String
  // The creator's original text, shown on the catalog card.
  topicDisplay    String
  // normalizeTopic(topicDisplay) -- same function /api/game/route.ts already
  // runs on Game.topic before saving, so the two are directly comparable
  // without re-normalizing at read time. Case-sensitive (normalizeTopic only
  // trims/collapses whitespace), so this is the dedup key, not a perfect one.
  topicNormalized String
  // Same format/default as Game.language -- the language the topic was
  // actually played/created in. Part of the uniqueness key: the same topic
  // played for the first time in a different language gets its own native
  // row rather than overwriting this one. The default is a push-time safety
  // net only (same as Game.language) -- every insert already passes
  // language explicitly, see /api/quiz/submit/route.ts.
  language        String    @default("fr")
  // The difficulty of the Game that created this entry -- never recomputed
  // from later plays of the same topic.
  difficulty      String
  createdAt       DateTime  @default(now())
  // Manual moderation switch for a future admin tool -- nothing sets this
  // yet.
  hidden          Boolean   @default(false)
  createdByGameId String?
  // Lazily-filled cache of { [language]: translatedLabel }, populated only
  // when getCategoryTopics() has to borrow this row to pad out a thin
  // native-language result set for another locale (see
  // src/lib/categoryTopics.ts). Null/missing entries mean "not translated
  // yet for that language" -- never the questions themselves, just this
  // short card label.
  translatedLabels Json?

  @@unique([categorySlug, topicNormalized, language])
  @@index([categorySlug])
  @@index([topicNormalized, language])
}
