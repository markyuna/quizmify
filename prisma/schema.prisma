generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "account_userId_idx")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
}

model User {
  id                             String                         @id @default(cuid())
  name                           String?
  email                          String?                        @unique
  emailVerified                  DateTime?
  image                          String?
  password                       String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  subscriptionStatus             String                         @default("free")
  stripeCustomerId               String?
  stripePaymentId                String?                        @unique
  xp                             Int                            @default(0)
  level                          Int                            @default(1)
  currentStreak                  Int                            @default(0)
  longestStreak                  Int                            @default(0)
  lastQuizDate                   DateTime?
  streakProtectionsUsed          Int                            @default(0)
  streakProtectionMonth          String?
  // IANA timezone (e.g. "America/Argentina/Buenos_Aires"), captured
  // client-side on login -- see TimezoneSync.tsx. Null until the user's
  // browser has reported it at least once; notification scheduling treats
  // that as "unknown, send anyway" rather than skipping them.
  timezone                       String?
  // Temporary Pro access granted by referrals or the free trial, additive
  // to (never a substitute for) a real paid subscriptionStatus="pro". See
  // isEffectivelyPro() in src/lib/paywall.ts -- the single source of truth
  // for every Pro gate in the app.
  premiumUntil                   DateTime?
  // Set once, the first time the free trial is activated -- distinct from
  // premiumUntil so "already used the trial" stays true even after it
  // expires and premiumUntil is in the past.
  freeTrialUsedAt                DateTime?
  // References an id in the hardcoded catalog in src/lib/avatarSkins.ts,
  // not a DB table -- same "visuals live in code, not the database" idiom
  // already used for avatar tiers and trophy shapes. Selection persists
  // even if Pro lapses; only *applying* it visually is gated on isPro at
  // read time (see dashboard/page.tsx), so it comes right back if they
  // resubscribe.
  selectedSkinId                 String?
  // The permanently-assigned "Quel animal es-tu?" result once claimed as
  // official (see PersonalityTestAttempt.isOfficial). Validated against
  // AnimalKey in src/lib/personalityTests/quelAnimalEsTu.config.ts rather
  // than a Prisma enum -- same "catalog lives in code" pattern as
  // PersonalityTestAttempt.resultKey. Set once and never overwritten:
  // /api/personality-tests/[testKey]/submit rejects a new attempt for a
  // user who already has one.
  personalityAnimal              String?
  // Set alongside personalityAnimal, in the same write -- null exactly
  // when personalityAnimal is null.
  personalityAnimalSetAt         DateTime?
  // Set each time the mascot-discovery nudge (MascotDiscoveryNudge.tsx, on
  // the 3 daily-game result screens) is dismissed by a logged-in visitor --
  // the nudge stays hidden for 7 days from this timestamp. Guests use
  // localStorage instead (no User row to persist it against yet).
  lastMascotNudgeDismissedAt     DateTime?
  // Read-cache of SUM(amount) over this user's NeuronTransaction rows --
  // same "cache field + ledger table" pattern UserDailyAttempt (guard
  // counter) + GuestAttempt (detail) already use elsewhere, applied to a
  // balance instead of a daily-attempt guard. NeuronTransaction is the
  // source of truth; this field only exists so reading the balance (e.g.
  // the dashboard header) doesn't require summing the whole ledger.
  neuronsBalance                 Int                            @default(0)
  accounts                       Account[]
  sessions                       Session[]
  games                          Game[]
  attempts                       Attempt[]
  questionProgress               UserQuestionProgress[]
  trophies                       Trophy[]
  certificates                   Certificate[]
  topicRecommendations           TopicRecommendation[]
  dailyChallengeAttempts         DailyChallengeAttempt[]
  notificationPreference         NotificationPreference?
  notificationLogs               NotificationLog[]
  friendshipsSent                Friendship[]                   @relation("FriendshipRequester")
  friendshipsReceived            Friendship[]                   @relation("FriendshipAddressee")
  referralsMade                  Referral[]                     @relation("ReferralsMade")
  referralReceived               Referral?                      @relation("ReferralReceived")
  guestAttemptsClaimed           GuestAttempt[]
  dailyAttempts                  UserDailyAttempt[]
  personalityTestAttemptsClaimed PersonalityTestAttempt[]
  curatedQuizCompletions         CuratedQuizCompletion[]
  categoryRecommendation         CategoryRecommendationMascota?
  puzzleDuJourGames              PuzzleDuJourGame[]
  neuronTransactions             NeuronTransaction[]
  neuronUnlocks                  NeuronUnlock[]
  neuronPurchases                NeuronPurchase[]
  morpionGames                   MorpionGame[]
  akinatorGames                  AkinatorGame[]

  @@index([xp])
}

model Game {
  id                   String     @id @default(cuid())
  gameType             GameType
  timeStarted          DateTime   @default(now())
  timeEnded            DateTime?
  topic                String
  difficulty           String?
  language             String     @default("en")
  // Nullable to support guest-played quizzes (see src/app/api/game/route.ts):
  // exactly one of userId/guestId is set. userId is set for real users, and
  // gets backfilled onto a guest's game by /api/guest/claim-quiz the moment
  // they register -- guestId is left in place after that purely as a claim
  // audit trail, never re-read for access control once claimedAt is set.
  userId               String?
  // Opaque id from the quizmify_guest cookie (same non-PII partition-key
  // pattern as GuestAttempt.guestId in guestPlay.ts). Set only while a game
  // has no owning account yet.
  guestId              String?
  // Set once, the first time a guest's game is migrated onto a real account
  // by /api/guest/claim-quiz -- null means "still guest-owned, or always was
  // a real user's game." Never re-applied once set (mirrors
  // GuestAttempt.claimedByUserId/claimedAt).
  claimedAt            DateTime?
  score                Int        @default(0)
  isTimed              Boolean    @default(false)
  timePerQuestionSec   Int?
  // Set only for quizzes long enough to split into two adaptive-difficulty
  // batches (see src/lib/adaptiveDifficulty.ts). Null means "generated
  // upfront as one batch, no adaptation" -- the pre-existing behavior for
  // short quizzes and every non-/api/game creation path (daily challenge,
  // Practice Mistakes), and always the case for guest-played quizzes.
  plannedQuestionCount Int?
  // Set only when this game was created with Puzzle Mode (Pro-only): a
  // DALL-E image generated from the topic, persisted to Supabase Storage
  // (OpenAI's own URLs expire after about an hour). Its presence is what
  // drives rendering the jigsaw reveal in MCQ.tsx -- there's no separate
  // boolean, since a game either has a puzzle image or it doesn't.
  puzzleImageUrl       String?
  // Set at creation time (POST /api/game) when the player already knew --
  // explicitly picked, or inherited from a category catalog page -- which
  // category this topic belongs to. Validated against CATEGORIES in
  // src/lib/categories.ts at write time, not a Prisma enum. This is the
  // server-authoritative source /api/quiz/submit reads from to publish a
  // CategoryTopic row -- deliberately not re-trusted from the client at
  // submit time, so a hidden category selector (see QuizCreation.tsx) can't
  // be worked around by tampering with the submit request.
  categorySlug         String?
  user                 User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions            Question[]
  attempts             Attempt[]
  trophies             Trophy[]

  @@index([userId])
  @@index([userId, timeStarted])
  @@index([guestId])
}

model McqQuestion {
  id             String   @id @default(cuid())
  topic          String
  difficulty     String
  language       String   @default("en")
  question       String
  options        String[]
  correct_answer String
  explanation    String?
  country        String?
  is_active      Boolean  @default(true)
  usage_count    Int      @default(0)
  created_at     DateTime @default(now())

  @@map("mcq_questions")
}

model Question {
  id               String                 @id @default(cuid())
  question         String
  answer           String
  options          String[]
  questionType     String
  explanation      String?
  userAnswer       String?
  isCorrect        Boolean?
  orderIndex       Int?
  country          String?
  imageUrl         String?
  gameId           String
  sourceQuestionId String?
  game             Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progressEntries  UserQuestionProgress[]

  @@index([gameId])
  @@index([sourceQuestionId])
}

model Attempt {
  id             String          @id @default(cuid())
  userId         String
  gameId         String
  score          Int
  totalQuestions Int
  correctAnswers Int
  timeSpent      Int
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers        AttemptAnswer[]

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([createdAt])
}

model AttemptAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  responseTimeMs Int?
  attempt        Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// One row per (user, curated topic) the user has ever earned XP for --
// the anti-grinding guard for curated quizzes (see quiEstLePeintre.ts):
// unlike AI-generated topics, a curated quiz's question pool is fixed, so
// nothing stops a user from creating a fresh Game for the same topic over
// and over and collecting XP every time. /api/quiz/submit and
// /api/guest/claim-quiz both attempt to create this row before crediting
// XP for a curated-topic game; a unique constraint violation means this
// user already has XP for that topic, so that submit/claim grants no
// additional XP (the game itself, streak, certificates and trophies are
// never gated -- replaying is still allowed and still full-featured for
// practice, only the XP grant is one-time). Mirrors NotificationLog's
// unique-constraint-is-the-real-guard pattern.
model CuratedQuizCompletion {
  id              String   @id @default(cuid())
  userId          String
  categorySlug    String
  topicNormalized String
  gameId          String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categorySlug, topicNormalized])
  @@index([userId])
}

enum GameType {
  mcq
}

model Certificate {
  id       String          @id @default(cuid())
  userId   String
  kind     CertificateKind
  // Empty string ("") for kinds not scoped to a topic (quizzes_50, streak_7)
  // rather than null -- Postgres treats NULL as distinct-from-itself in
  // unique indexes, which would silently defeat @@unique below.
  topic    String          @default("")
  earnedAt DateTime        @default(now())
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, topic])
  @@index([userId])
}

enum CertificateKind {
  quizzes_50
  category_mastery
  streak_7
}

// Cached AI-generated "practice this topic" suggestion, regenerated only
// when the user's stats move meaningfully (see src/lib/recommendations.ts)
// so we don't pay an OpenAI call on every dashboard load.
model TopicRecommendation {
  id                    String   @id @default(cuid())
  userId                String
  // Part of the cache key (not just a display field) so switching the
  // site's language doesn't keep serving a message generated in the old
  // one -- each language gets its own cached row per user.
  language              String   @default("en")
  topic                 String
  message               String
  accuracy              Float
  quizCountAtGeneration Int
  generatedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
}

// Server-computed "qué categoría practicar/explorar" para un usuario con
// cuenta -- reemplaza por completo el cold-start de categoryScores
// (PersonalityTestAttempt, Fase 2) una vez que hay cuenta creada, sin
// esperar ningún umbral de actividad (a diferencia de TopicRecommendation).
// Una sola fila por usuario -- a diferencia de TopicRecommendation, no
// depende del idioma: es una lista de slugs de categoría, no texto
// generado, así que no hay nada que traducir acá (el widget que la
// consuma resuelve slug -> nombre/ícono localizado en el momento de
// renderizar, igual que ya hace PersonalityResultModal).
// See getOrGenerateCategoryRecommendation() in src/lib/categoryRecommendations.ts.
model CategoryRecommendationMascota {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  // Array ordenado de hasta 3 CategorySlug (string, catálogo en código --
  // ver CATEGORY_SLUGS en src/lib/personalityTests/quelAnimalEsTu.config.ts,
  // mismo patrón "catálogo vive en código" que resultKey/categoryScores),
  // p.ej. ["geographie", "arts", "cinema"]. Débiles primero, luego no
  // exploradas por orden de catálogo -- ver rankCategoriesForUser().
  recommendedSlugs         Json
  // Cantidad de Attempts de este usuario con Game.categorySlug no-nulo al
  // momento de generar -- comparado contra un conteo en vivo en cada
  // lectura para decidir staleness (mismo patrón que isStale() en
  // src/lib/recommendations.ts). A diferencia de TopicRecommendation,
  // CUALQUIER delta (>=1) dispara recálculo -- no hay umbral de actividad
  // para este motor.
  attemptCountAtGeneration Int
  generatedAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trophy {
  id          String     @id @default(cuid())
  userId      String
  gameId      String?
  kind        TrophyKind
  streakCount Int?
  createdAt   DateTime   @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([gameId])
}

enum TrophyKind {
  perfect
  streak
}

model UserQuestionProgress {
  id                    String   @id @default(cuid())
  userId                String
  questionId            String
  wrongCount            Int      @default(0)
  correctCount          Int      @default(0)
  needsReview           Boolean  @default(false)
  lastAnsweredCorrectly Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([userId, needsReview])
}

// One shared quiz per UTC calendar day *per language*, identical for every
// user in that language. `date` is a "YYYY-MM-DD" string (not a DateTime)
// purely so it can be part of a simple composite unique key -- see
// src/lib/dailyChallenge.ts for generation/lookup.
model DailyChallenge {
  id         String   @id @default(cuid())
  date       String
  topic      String
  difficulty String
  language   String
  createdAt  DateTime @default(now())

  questions DailyChallengeQuestion[]
  attempts  DailyChallengeAttempt[]

  @@unique([date, language])
}

model DailyChallengeQuestion {
  id               String   @id @default(cuid())
  dailyChallengeId String
  question         String
  answer           String
  options          String[]
  explanation      String?
  orderIndex       Int

  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@index([dailyChallengeId])
}

model DailyChallengeAttempt {
  id                  String   @id @default(cuid())
  dailyChallengeId    String
  userId              String
  score               Int
  correctAnswers      Int
  totalQuestions      Int
  timeSpent           Int
  // XP breakdown, stored (not just returned) so the "already played" view
  // can show the same numbers on a later page load, not just right after
  // submit. earnedXp is the actual amount applied to User.xp (may be less
  // than baseXp + aboveAverageBonusXp if it was clamped by the free-tier cap).
  baseXp              Int      @default(0)
  aboveAverageBonusXp Int      @default(0)
  earnedXp            Int      @default(0)
  createdAt           DateTime @default(now())

  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces "one attempt per user per day" at the database level, not just
  // in application code.
  @@unique([dailyChallengeId, userId])
  @@index([dailyChallengeId])
  @@index([userId])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  streakReminderEmail Boolean  @default(true)
  dailyChallengeEmail Boolean  @default(true)
  weeklySummaryEmail  Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  streak_reminder
  daily_challenge_reminder
  weekly_summary
  premium_ending_soon
}

model NotificationLog {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  // User's local calendar date ("YYYY-MM-DD") at send time for
  // streak_reminder/daily_challenge_reminder, or the ISO week ("YYYY-Www")
  // for weekly_summary. The real anti-duplicate guard is the unique
  // constraint below, not the application check that precedes it.
  dateKey String
  sentAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dateKey])
  @@index([userId])
}

enum FriendshipStatus {
  pending
  accepted
}

// A pending row means requester -> addressee only; it becomes a mutual
// friendship the moment addressee accepts. There's deliberately no way to
// read someone's progress via this relation while status is "pending" --
// see getFriendIds() in src/lib/friends.ts, which only ever queries
// status: accepted.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

// One row per successfully-referred signup. @@unique on referredId means a
// given account can only ever be counted as "referred" once, by whoever's
// link they used first.
model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  rewardDays Int
  createdAt  DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

enum GuestGameKey {
  word_of_day
  photo_of_day
  math_target
}

// One shared daily challenge per game per calendar day (UTC "YYYY-MM-DD")
// per language -- same idiom as DailyChallenge, but payload is opaque JSON
// because each guest game has a completely different challenge shape (a
// target word vs. a photo+location vs. a target number+operands). Never
// includes the answer key -- that's derived server-side at submit time by
// the grader registered for this gameKey in src/lib/guestPlay.ts.
model DailyGameChallenge {
  id        String       @id @default(cuid())
  gameKey   GuestGameKey
  date      String
  language  String       @default("en")
  payload   Json
  createdAt DateTime     @default(now())

  attempts     GuestAttempt[]
  userAttempts UserDailyAttempt[]

  @@unique([gameKey, date, language])
  @@index([gameKey, date])
}

// A guest's single daily attempt at one game, before any account exists.
// guestId is an opaque id minted client-side and stashed in a cookie (same
// pattern as the quizmify_ref referral cookie) -- never PII. Scored and
// persisted server-side so the result can't be forged by the client, and so
// it survives the guest closing the conversion modal and coming back later
// in the same browser. claimedByUserId/claimedAt are set once, the first
// time /api/guest/claim successfully migrates this attempt onto a real
// account; already-claimed rows are never re-applied.
model GuestAttempt {
  id              String       @id @default(cuid())
  challengeId     String
  gameKey         GuestGameKey
  date            String
  guestId         String
  resultPayload   Json
  isCorrect       Boolean
  xpEarned        Int
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime     @default(now())

  challenge        DailyGameChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  claimedBy        User?              @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  // Set only on the one GuestAttempt (across possibly several guestIds/
  // languages for the same userId+gameKey+day) that actually won the
  // UserDailyAttempt race -- see that model's own comment. A claimed
  // GuestAttempt with no userDailyAttempt is a same-day duplicate that got
  // claimedByUserId set for audit purposes but was never credited.
  userDailyAttempt UserDailyAttempt?

  // One attempt per guest per game per day -- mirrors the
  // [dailyChallengeId, userId] guard on DailyChallengeAttempt. This is a
  // per-guestId guard only -- UserDailyAttempt is the per-userId one,
  // independent of which guestId/language produced the winning attempt.
  @@unique([challengeId, guestId])
  @@index([guestId])
  @@index([claimedByUserId])
}

// Ledger of "one attempt per user, per game, per calendar day" for the 3
// guest games (word_of_day/photo_of_day/math_target) once played by an
// authenticated account -- the real fix for the guestId-based guard above
// only ever knowing about the current browser's cookie, never the actual
// account (see the investigation that led here: a Pro user could replay a
// daily game and double-earn XP just by switching device/clearing the
// cookie while still logged in). Doesn't duplicate the graded result --
// guestAttemptId points at whichever GuestAttempt actually won the day,
// same content as always lived there. GuestAttempt itself is untouched:
// still the per-guestId tracking and the only place resultPayload lives.
model UserDailyAttempt {
  id             String       @id @default(cuid())
  userId         String
  gameKey        GuestGameKey
  // UTC calendar day "YYYY-MM-DD" -- same format/timezone as
  // DailyGameChallenge.date and GuestAttempt.date (getTodayDateKey()).
  // Deliberately not keyed by language/challengeId: the guard is "one per
  // day regardless of which language you played it in" -- see the
  // colateral finding in the investigation this table closes.
  date           String
  // Denormalized from guestAttempt.challengeId -- same convenience
  // pattern GuestAttempt itself already uses for date/gameKey.
  challengeId    String
  guestAttemptId String       @unique
  isCorrect      Boolean
  xpEarned       Int
  createdAt      DateTime     @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge    DailyGameChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  guestAttempt GuestAttempt       @relation(fields: [guestAttemptId], references: [id], onDelete: Cascade)

  @@unique([userId, gameKey, date])
  @@index([userId])
  @@index([challengeId])
}

// Personality tests are evergreen content (not date-rotated like the 3
// GuestGameKey games) with no correct/incorrect answer -- just an
// accumulated score per candidate result, so they get their own key enum
// and attempt model rather than reusing GuestGameKey/GuestAttempt/
// DailyGameChallenge. Question/option/weight/result-profile content lives
// in code (src/lib/personalityTests/*.config.ts) + messages/*.json, not in
// the database -- it's fixed editorial content, not AI-generated or
// admin-edited, so there's nothing here that needs a content table.
enum PersonalityTestKey {
  quel_animal_es_tu
}

// A guest's (or user's) run through one personality test. Unlike
// GuestAttempt there is no daily-challenge relation and no unique
// constraint on [testKey, guestId] -- retaking an evergreen test is
// expected, not an edge case. guestId/claimedByUserId/claimedAt mirror
// GuestAttempt exactly: scored and persisted server-side so the result
// can't be forged by the client and can't be read back before the guest
// registers (see /api/personality-tests/[testKey]/submit).
model PersonalityTestAttempt {
  id              String             @id @default(cuid())
  testKey         PersonalityTestKey
  guestId         String
  // [{ questionId: "q1", optionId: "q1_b" }, ...] -- the guest's raw picks,
  // kept so a future "see your answers" or re-scoring pass has something
  // to work from.
  answers         Json
  // Final per-animal point totals, e.g. { lion: 4, dauphin: 2, ... } --
  // computed server-side by computeResult(), never trusted from the client.
  scores          Json
  // The winning animal key, e.g. "lion" -- denormalized out of `scores` so
  // the result page and OG metadata don't need to re-run the tie-break
  // logic every render.
  resultKey       String
  // Per-category interest totals from the Q9-13 thematic axis (top 3,
  // scores > 0 only) -- see computeResult() in scoring.ts. Independent of
  // scores/resultKey (the animal axis); unused in this phase, feeds the
  // future recommendation engine (Phase 3).
  categoryScores  Json?
  claimedByUserId String?
  claimedAt       DateTime?
  // True for exactly one attempt per user across all time -- the one whose
  // resultKey was written to User.personalityAnimal, either at claim time
  // (guest -> account, most-recent-unclaimed-attempt wins) or directly at
  // submit time for an already-authenticated user's first attempt. Never
  // moved to a different row or flipped back to false once set, since
  // personalityAnimal itself is permanent. Enforced only in application
  // logic (claimPersonalityTestAttempts / the direct-submit path), not by
  // a DB constraint.
  isOfficial      Boolean            @default(false)
  createdAt       DateTime           @default(now())

  claimedBy User? @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([guestId])
  @@index([claimedByUserId])
  @@index([testKey, resultKey])
}

// A free-topic quiz (Game.topic) published into one of the 18 categories in
// src/lib/categories.ts once its creator (an authenticated user, never a
// guest -- see POST /api/quiz/submit) finishes it, so other users can play
// the exact same cached questions without spending new AI tokens. No FK
// relation to Game (relationMode = "prisma", and this row must outlive the
// Game it came from) -- createdByGameId is plain traceability, not a join
// target. Deliberately no play-count/trending counter here: popularity is
// computed at read time from Game.topic + Game.timeEnded (see
// src/lib/categoryTopics.ts), so there's nothing here to desync.
model CategoryTopic {
  id               String   @id @default(cuid())
  // Validated against CATEGORIES in src/lib/categories.ts at write time, not
  // a Prisma enum -- categories are edited in code, not via migration.
  categorySlug     String
  // The creator's original text, shown on the catalog card.
  topicDisplay     String
  // normalizeTopic(topicDisplay) -- same function /api/game/route.ts already
  // runs on Game.topic before saving, so the two are directly comparable
  // without re-normalizing at read time. Case-sensitive (normalizeTopic only
  // trims/collapses whitespace), so this is the dedup key, not a perfect one.
  topicNormalized  String
  // Same format/default as Game.language -- the language the topic was
  // actually played/created in. Part of the uniqueness key: the same topic
  // played for the first time in a different language gets its own native
  // row rather than overwriting this one. The default is a push-time safety
  // net only (same as Game.language) -- every insert already passes
  // language explicitly, see /api/quiz/submit/route.ts.
  language         String   @default("fr")
  // The difficulty of the Game that created this entry -- never recomputed
  // from later plays of the same topic.
  difficulty       String
  createdAt        DateTime @default(now())
  // Manual moderation switch for a future admin tool -- nothing sets this
  // yet.
  hidden           Boolean  @default(false)
  createdByGameId  String?
  // Lazily-filled cache of { [language]: translatedLabel }, populated only
  // when getCategoryTopics() has to borrow this row to pad out a thin
  // native-language result set for another locale (see
  // src/lib/categoryTopics.ts). Null/missing entries mean "not translated
  // yet for that language" -- never the questions themselves, just this
  // short card label.
  translatedLabels Json?

  @@unique([categorySlug, topicNormalized, language])
  @@index([categorySlug])
  @@index([topicNormalized, language])
}

enum PuzzleDuJourDifficulty {
  easy
  medium
  hard
}

enum PuzzleDuJourStatus {
  in_progress
  completed
}

// Pro-only, on-demand daily puzzle: each row is one user's own free-topic
// image jigsaw, not a shared daily challenge -- deliberately NOT reusing
// UserDailyAttempt/GuestAttempt/DailyGameChallenge, which all model "one
// shared challenge per calendar day." See the investigation that ruled out
// that reuse (guestAttemptId there is a required FK, and there's no
// concept of a global "today's puzzle" here).
//
// A row is only ever inserted after image generation succeeds -- a
// content-moderation-rejected topic never gets a row, so it doesn't count
// against the daily cap. See POST /api/puzzle-du-jour.
model PuzzleDuJourGame {
  id              String                 @id @default(cuid())
  userId          String
  // UTC calendar day "YYYY-MM-DD" -- same convention as
  // UserDailyAttempt.date. Only used to COUNT today's rows against the
  // 2/day cap -- NOT part of a uniqueness constraint, since a user can
  // have up to 2 rows for the same date.
  date            String
  // Exactly what the user typed (trimmed), for display in the puzzle
  // title/history -- never overwritten with the normalized form.
  topic           String
  // normalizeTopic(topic) -- same convention CategoryTopic/
  // CuratedQuizCompletion use. Paired with `language` to find a cacheable
  // image for this topic before spending money generating a new one,
  // regardless of difficulty or which user asked for it first.
  topicNormalized String
  language        String                 @default("en")
  difficulty      PuzzleDuJourDifficulty
  gridCols        Int
  gridRows        Int
  imageUrl        String
  status          PuzzleDuJourStatus     @default(in_progress)
  completedAt     DateTime?
  xpEarned        Int                    @default(0)
  createdAt       DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([topicNormalized, language])
}

enum NeuronTransactionType {
  earn_quiz
  spend_unlock
  bonus_personality
  spend_morpion
  // Per-game debit for Akinator, taken at game creation (POST /api/akinator)
  // -- same direct updateMany decrement as spend_morpion, never a
  // NeuronUnlock ticket.
  spend_akinator
  // A real-money purchase from the Neuron shop (Stripe checkout). Credited
  // by creditNeuronsForPurchase() from the Stripe webhook; the matching
  // NeuronPurchase row is the anti-double-credit guard (unique on
  // stripeSessionId), not the ledger itself.
  purchase
}

// Ledger of every "Neurons" (fr: Neurones, en: Neurons) earn/spend/bonus
// event -- the source of truth for a user's balance. User.neuronsBalance is
// just a read-cache of SUM(amount) over these rows for this userId. amount
// is signed on purpose (positive for earn_quiz/bonus_personality, negative
// for spend_unlock) so the balance is always exactly SUM(amount) -- no
// separate credit/debit columns to keep in sync.
model NeuronTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          NeuronTransactionType
  amount        Int
  // Which game this event relates to -- null for earn_quiz (not tied to a
  // specific unlockable game, it's earned from ordinary AI quiz play) and
  // bonus_personality (not a game at all). Deliberately a plain String, not
  // GameKey/GuestGameKey: Puzzle du Jour -- the first spend_unlock consumer
  // -- is a member of neither enum (see GAMES_CATALOG's own history in this
  // codebase for why).
  gameKey       String?
  // Which Game produced an earn_quiz transaction, for tracing "why did my
  // balance go up." No FK relation to Game (relationMode = "prisma", and
  // this ledger row must outlive the Game it came from) -- same "plain
  // traceability, not a join target" stance as CategoryTopic.createdByGameId.
  relatedGameId String?
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([relatedGameId])
}

// One row per Stripe checkout for a Neuron package. Created `pending` when
// the checkout session is opened (POST /api/checkout/neurons) and flipped
// to `completed` by the Stripe webhook, which also writes the matching
// `purchase` NeuronTransaction and bumps User.neuronsBalance -- all in one
// $transaction (see creditNeuronsForPurchase). `stripeSessionId` is unique
// so a retried webhook can't double-credit: the credit only happens on the
// pending -> completed transition. No FK to Game/anything; this is a
// payment record that must outlive everything it references.
model NeuronPurchase {
  id              String    @id @default(cuid())
  userId          String
  stripeSessionId String    @unique
  // Catalog key from src/lib/neurons/shop.ts (SMALL/MEDIUM/LARGE/XL) --
  // plain String, validated in code, same "catalog lives in code" stance
  // as NeuronTransaction.gameKey.
  packageKey      String
  // Neurons bought -- the amount credited on completion.
  neuronAmount    Int
  // Price actually charged, in the smallest currency unit (EUR cents).
  // Read back from the Stripe session (amount_total), not trusted from the
  // client.
  amountCents     Int
  currency        String    @default("EUR")
  // "pending" | "completed" | "failed" -- plain String, no enum, mirroring
  // how the rest of this schema treats short lifecycle states.
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NeuronUnlockStatus {
  available
  used
}

// A purchased, persistent "ticket" to unlock one play of a premium game
// without spending Neurons again at play time -- doesn't expire, sits
// `available` until consumed. No uniqueness constraint on
// [userId, gameKey] deliberately -- see the trade-off note in the schema
// proposal report about whether multiple accumulated available tickets per
// game (to unlock several days in a row) should be allowed or capped, and
// at which layer (DB constraint vs. application check) that belongs.
model NeuronUnlock {
  id          String             @id @default(cuid())
  userId      String
  gameKey     String
  status      NeuronUnlockStatus @default(available)
  purchasedAt DateTime           @default(now())
  usedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameKey, status])
}

enum MorpionDifficulty {
  easy
  medium
  hard
}

enum MorpionStatus {
  in_progress
  won
  lost
  draw
}

enum MorpionSymbol {
  X
  O
}

model MorpionGame {
  id           String            @id @default(cuid())
  userId       String
  board        String // JSON serializado del tablero 3x3
  difficulty   MorpionDifficulty
  status       MorpionStatus     @default(in_progress)
  playerSymbol MorpionSymbol     @default(X)
  xpEarned     Int               @default(0)
  createdAt    DateTime          @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

enum AkinatorStatus {
  in_progress
  won
  lost
}

// "20 questions" game: the AI holds a secret character (one of the curated
// keys in src/lib/akinator/characters.ts) and the player asks yes/no
// questions to figure out who it is. Same "state as a serialized JSON
// string" pattern as MorpionGame.board.
model AkinatorGame {
  id             String         @id @default(cuid())
  userId         String
  // Catalog key from src/lib/akinator/characters.ts -- plain String,
  // validated in code, same stance as NeuronTransaction.gameKey.
  characterKey   String
  // JSON array of OpenAI chat messages: [{ role: "user"|"assistant",
  // content }]. Replayed in full on every /question call (chat completions
  // are stateless).
  conversation   String
  questionsAsked Int            @default(0)
  // The player's final guess text, whether right or wrong.
  guessedName    String?
  status         AkinatorStatus @default(in_progress)
  // 20 - questionsAsked at the moment of a correct guess; null until won.
  score          Int?
  xpEarned       Int            @default(0)
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}
